# Комментарии пишите только на отдельных строках: docker compose считает
# «VAR=   # текст» значением «# текст», если перед # нет значения.

# --- Telegram ---
TG_BOT_TOKEN=
# Ваш числовой Telegram ID; несколько — через запятую
ADMIN_IDS=
# Необязательно: стартовый канал/группа (-100...). Обычно пусто — каналы и группы
# добавляются в меню бота «✈ Telegram» и хранятся в SQLite.
TG_TARGET_CHAT_ID=

# --- MAX ---
# Необязательно: токен можно прислать боту в меню «🟣 MAX» → «🔑 Подключить».
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
# Необязательно: стартовый чат MAX. Обычно пусто — чаты выбираются в меню «🟣 MAX».
MAX_TARGET_CHAT_ID=

# --- WhatsApp ---
# evolution | greenapi
WA_PROVIDER=evolution
# Необязательно: стартовый список групп через запятую (1203...@g.us,1203...@g.us).
# Обычно оставьте пустым — группы и паузы выбираются в меню бота и хранятся в SQLite.
WA_GROUP_IDS=
# Показывать «печатает» 2–5 с перед отправкой
WA_TYPING=true

# Evolution API
EVOLUTION_URL=http://evolution-api:8080
# Длинная случайная строка: openssl rand -hex 32
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=main

# GREEN-API (резерв)
GREENAPI_API_URL=https://api.green-api.com
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=

# --- Postgres для Evolution ---
POSTGRES_USER=evolution
# Только буквы и цифры: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=evolution

# --- Прочее ---
DB_PATH=/data/bot.sqlite3
LOG_LEVEL=INFO
TZ=Europe/Moscow
